{
  "schema": "hve.runtime-acceptance-contract",
  "version": 2,
  "behavior_engine": "@microsoft/vally",
  "behavior_requirement": "independently verified full converted upstream suite and channel-specific custom Vally cases using original scoring",
  "host_surfaces": [
    "cli",
    "desktop"
  ],
  "host_checks": [
    "implicit-research-selection",
    "explicit-only-negative-routing",
    "trusted-hooks-native-positive-negative-resume",
    "delegated-native-role-and-hook-context",
    "child-read-only-permission"
  ],
  "deferred_checks_are_required": true,
  "scheduled_model_calls": false,
  "reviewed_historical_acceptance": {
    "policy": "mappings/release-acceptance.json",
    "selection": "explicit --acceptance-policy",
    "behavior_requirement": "reviewed historical baseline with original failed and blocked outcomes preserved",
    "deferred_host_checks": [
      "child-read-only-permission"
    ],
    "candidate_cli_and_desktop_evidence_required": true,
    "fresh_candidate_full_suite_claim": false
  }
}
